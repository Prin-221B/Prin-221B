-- Q7


-- Q8
select
  o.user_id,
  sum(revenue) * 1.0 / count(session_id) as arps
from orders o
left join sessions s on o.user_id = s.user_id
group by o.user_id, s.user_id 

-- Q9
with segements as (
  select 
  user_id,
  case 
    when predicted_churn_prob > 0.7 then 'high risk'
    when predicted_churn_prob > 0.4 then 'medium'
    when predicted_churn_prob < 0.4 then 'low'
  end as segement
  from predictions
)

select 
  segement,
  count(distinct s.user_id) as total_users, 
  sum(o.revenue) * 1.0 as total_revenue,
  sum(o.revenue) * 1.0 / count(distinct s.user_id) as avg_revenue 
from segements s
left join orders o on s.user_id = o.user_id
group by s.segement

-- Q10
with scores as (
  select 
  user_id,
  case 
    when event_type = 'view'        then 1
    when event_type = 'click'       then 2
    when event_type = 'add_to_cart' then 3
    when event_type = 'purchase'    then 5
  end as score
  from events 
)

select
  user_id,
  sum(score) * 1.0 as total_score
from scores
group by user_id
order by total_score desc 
limit 20 ;
