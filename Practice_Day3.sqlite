-- Q1
select 
  user_id,
  count(user_id) as total_orders
from  orders 
group by user_id ;

-- Q2
select
  sum(revenue) / count(order_id) as avg_order_value
from orders

-- Q3
select 
  user_id,
  sum(revenue) as total_revenue
from orders 
group by user_id 
order by total_revenue desc
limit 5 ;

-- Q4
select 
  user_id,
  sum(revenue) as total_revenue,
  rank() over(order by sum(revenue) desc) as rank
from orders 
group by user_id 

-- Q5
select
  user_id,
  min(order_time) as first_order
from orders 
group by user_id ;

-- Q6
select 
  u.user_id,
  signup_date,
  order_time,
  julianday(min(order_time)) - julianday(signup_date) as day_to_purchase
from users u
left join orders o on u.user_id = o.user_id
where order_time is not nul
group by u.user_id
 
-- Q7
select 
  activity_date,
  count(distinct (user_id)) as total_users
from user_activity
group by activity_date

-- Q8
select
  user_id,
  count(activity_type) as total_activity
from user_activity
where activity_type = 'login' 
group by user_id
having total_activity > 5 ;

-- Q9
select 
  order_time,
  revenue,
  SUM(revenue) OVER (ORDER BY order_time) as cumulative_revenue
from orders 

-- Q10
select 
  user_id,
  activity_date as latest_activity
from (
  select
    *,
    row_number () over(partition by user_id order by activity_date desc) as row_num
  from user_activity)
where row_num = 1
