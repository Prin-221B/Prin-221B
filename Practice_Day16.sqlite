-- Q1 คำนวณ Month-1 Retention Rate ของแต่ละ cohort (เดือน signup)
with user_cohort as (
  select 
    user_id,
    strftime('%Y-%m', signup_date) as cohort_month
  from users 
),

order_months as (
  select 
    user_id,
    strftime('%Y-%m', order_time) as order_month
  from orders
),

month0 as (
  select 
    uc.user_id,
    uc.cohort_month
  from user_cohort uc 
  join order_months om on uc.user_id = om.user_id
  and om.order_month = uc.cohort_month
),

month1 as (
  select 
    uc.user_id,
    uc.cohort_month
  from user_cohort uc
  join order_months om on uc.user_id = om.user_id
  and om.order_month = strftime('%Y-%m', 
      date(uc.cohort_month||'-01', '+1 month'))
)

select 
  m0.cohort_month,
  count(distinct m0.user_id) as month0_buyer,
  count(distinct m1.user_id) as month1_buyer,
  round(count(distinct m1.user_id) * 100.0 / count(distinct m0.user_id), 2) as retention_rate
from month0 m0 
left join month1 m1 on m0.user_id = m1.user_id
group by m0.cohort_month

-- Q2 Conversion funnel by sessions
with session_funnel as (
  select
    session_id,
    max(case when event_type = 'view' then 1 else 0 end) as has_view,
    max(case when event_type = 'add_to_cart' then 1 else 0 end) as has_cart,
    max(case when event_type = 'purchase' then 1 else 0 end) as has_purchase
  from events
  group by session_id  
)

select 
  count(*)          as total_session,
  sum(has_view)     as total_view,
  sum(has_cart)     as total_cart,
  sum(has_purchase) as total_puchase,
  round(sum(has_cart) * 100.0 / nullif(sum(has_view), 0), 2) as view_to_cart_pct,
  round(sum(has_purchase) * 100.0 / nullif(sum(has_cart), 0), 2) as cart_to_purchase_pct
from session_funnel 

-- Q3 A/B Test analysis - revenue per user by variant
select 
  e.variant,
  count(distinct o.user_id) as users,
  count(distinct o.order_id) as total_order,
  sum(o.revenue) as total_revenue,
  round(sum(o.revenue) * 1.0 / count(distinct o.user_id),2) as revenue_per_user
from experiments e
left join orders o on e.user_id = o.user_id 
group by e.variant

-- Q4 Churn risk bucketing 
with user_risk as (
  select 
    user_id,
    predicted_churn_prob,
    case 
      when predicted_churn_prob > 0.7 then 'High Risk'
      when predicted_churn_prob >= 0.4 then 'Medium Risk'
      when predicted_churn_prob < 0.4 then 'Low Risk'
    end risk 
  from predictions  
)

select 
  ur.risk,
  count(distinct o.user_id) as users,
  round(avg(predicted_churn_prob), 2) as avg_churn_prob,
  round(avg(coalesce(o.total_rev, 0)), 2) as avg_lifetime_value
from user_risk ur
  left join (
  select user_id, sum(revenue) AS total_rev
  from orders group by user_id) o on ur.user_id = o.user_id 
group by ur.risk 

-- Q5 CTR ตาม Channel x type
select 
  channel,
  notification_type,
  count(*) as sent,
  sum(clicked) as click,
  round(sum(clicked) * 100.0 / count(*), 2) as ctr
from notifications
group by channel, notification_type
order by ctr desc ;

-- Q6 future adoption curve
with first_time as (
  select 
    user_id,
    feature_name,
    min(date(usage_date)) as firstdate
  from feature_usage
  group by user_id, feature_name  
)

select 
  feature_name,
  strftime('%Y-%m', firstdate) as month,
  count(distinct user_id) as new_adoption
from first_time
group by feature_name, month

-- Q7 running revenue + rank by user
select 
  user_id,
  order_id,
  order_time,
  revenue,
  round(sum(revenue) over(partition by user_id order by order_time rows UNBOUNDED PRECEDING), 2) as running_total,
  row_number() over(partition by user_id order by revenue desc) as rank_by_rev
from orders 
where user_id in (1,2,3)

-- Q8 Support Tickiet Lag Analysis 
with ticket_lag as (
  select 
    st.ticket_id,
    st.user_id,
    st.priority,
    st.created_at,
    max(o.order_time)                                       as last_order_date,
    julianday(st.created_at) - julianday(max(o.order_time)) as day_since_order
  from support_tickets st
  left join orders o 
    on st.user_id = o.user_id
    and o.order_time <= st.created_at 
  group by st.ticket_id
)

select
  priority,
  count(*) as ticket,
  round(avg(day_since_order), 1) as avg_days_since_last_order,
  sum(case when day_since_order >= 30 then 1 else 0 end) as tickets_30plus_days
from ticket_lag
group by priority
