-- Q7
select
  country,
  sum(revenue) as total_revenue
from users u
left join orders o on u.user_id = o.user_id
group by country
order by 2 desc;

-- Q8
select 
  u.user_id,
  sum(revenue) as total_revenue
from users u
left join orders o on u.user_id = o.user_id
group by u.user_id
order by 2 desc ;

-- Q9
select
  strftime('%Y-%m', order_time) AS month,
  sum(revenue) as total_revenue
from orders 
group by month 
order by total_revenue ;

-- Q10
select 
  acquisition_channel,
  sum(revenue) as total_revenue
from users u
left join orders o on u.user_id = o.user_id
group by acquisition_channel
order by total_revenue desc ;
